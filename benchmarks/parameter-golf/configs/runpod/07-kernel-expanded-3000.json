      "rope": "partial",
      "backend": "quad",
      "projection_layout": "mamba-shared",
      "optimizer_policy": "muon-2d+theta",
      "expected_model_params": 17059976,
      "artifact_cap_bytes": 16000000,
      "required_log_regex": [
        "mixer_impl:ThetaScan",
        "model_params:17059976",
        "theta_projection_layout:mamba-shared",
        "optimizer_adam_theta_controls:tensor_count=8 parameter_count=2128",
        "thetascan_config:.*'family': 'kernel'",
        "thetascan_config:.*'feature_map': 'relu2_ridge'.*'relu2_threshold_mode': 'learned_per_head'",
        "thetascan_config:.*'feature_expansion': 2",
        "thetascan_config:.*'temporal': {'mode': 'bank'.*'recency_branches': 2.*'half_life_inits': \\(8\\.0, 64\\.0\\).*'blend_mode': 'free'",
        "kernel_relu2_threshold_per_head:",
        "bank_timescales_per_head:.*\"alpha\":\\[.*\"eta\":\\[.*\"half_life\":\\[",
        "ffn_hidden:full=1024 .*thetascan=1023",
        "final_int8_zlib_roundtrip_exact",
        "Total submission size int8\\+zlib: [0-9]+ bytes"
      ],
      "expected_theta_headwise_muon_tensors": 4,
      "expected_theta_headwise_muon_params": 393216
    }
  ]
