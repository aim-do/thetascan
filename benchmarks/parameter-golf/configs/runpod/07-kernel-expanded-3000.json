{
  "schema_version": 1,
  "suite_id": "public-h100-kernel-expanded-3000-v1",
  "description": "Reproducible 0-to-3000 run of the Kernel expanded reference: ReLU-squared ridge features with 2x random feature expansion and two recency branches. The int8 artifact exceeds the 16MB cap (research-only).",
  "seed_policy": "explicit_shared_across_pods",
  "hardware": {
    "gpu_count": 1,
    "gpu_type": "NVIDIA H100 80GB HBM3"
  },
  "launcher": {
    "hard_timeout_seconds": 7200,
    "result_grace_seconds": 300,
    "max_budget_usd": 6.25
  },
  "data": {
    "variant": "sp1024",
    "train_shards": 16
  },
  "protocols": {
    "smoke": {
      "iterations": 7500,
      "segment_start_step": 0,
      "segment_end_step": 20,
      "val_start_step": 0,
      "val_every": 20,
      "warmup_steps": 5,
      "warmdown_iters": 750,
      "max_wallclock_seconds": 600.0,
      "timeout_seconds": 900,
      "checkpoint_at_end": true,
      "research_allow_oversize_artifact": true
    },
    "production": {
      "iterations": 7500,
      "segment_start_step": 20,
      "segment_end_step": 3000,
      "val_start_step": 1000,
      "val_every": 250,
      "warmup_steps": 20,
      "warmdown_iters": 750,
      "max_wallclock_seconds": 0.0,
      "timeout_seconds": 5000,
      "checkpoint_at_end": true,
      "research_allow_oversize_artifact": true
    }
  },
  "runs": [
    {
      "id": "kernel-expanded-3000",
